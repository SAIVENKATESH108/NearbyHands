{
  "expo": {
    "name": "NearbyHands",
    "slug": "NearbyHands",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nearbyhands.app",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Allow $(PRODUCT_NAME) to access your photo library?",
        "NSPhotoLibraryUsageDescription": "This app accesses photo library to upload listings"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.nearbyhands.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}